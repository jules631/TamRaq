# ══════════════════════════════════════════════════════════════════════════════
# Demo environment — no Salesforce org or Auth0 account required.
#
# Usage:
#   cp .env.demo .env
#   docker-compose --profile demo up --build
#
# Then open http://localhost:5173
# ══════════════════════════════════════════════════════════════════════════════

# ── Postgres ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://tamarac:tamarac@localhost:5432/tamarac

# ── Demo mode flags ───────────────────────────────────────────────────────────
# Bypasses Auth0 JWT validation; accepts the static "demo-token" bearer token.
DEMO_MODE=true

# ── Auth0 (not used in demo mode, but required to start without errors) ───────
AUTH0_DOMAIN=demo.auth0.com
AUTH0_AUDIENCE=https://tamarac-fsc-connector/api

# ── Encryption ────────────────────────────────────────────────────────────────
APP_ENCRYPTION_KEY=QRKlVHcUWd7h3kbtolBOTJXNKSYI6ZgLx0gz33kBCsU=

# ── SSE token signing ─────────────────────────────────────────────────────────
SSE_TOKEN_SIGNING_KEY=demo-sse-signing-key-not-for-production-use

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
# Auth0 is not used in demo mode; these values are ignored.
VITE_AUTH0_DOMAIN=demo.auth0.com
VITE_AUTH0_CLIENT_ID=demo-client-id
VITE_AUTH0_AUDIENCE=https://tamarac-fsc-connector/api
# This is the key flag — tells the frontend to skip Auth0 entirely.
VITE_DEMO_MODE=true

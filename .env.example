# ── Postgres ──────────────────────────────────────────────────────────────────
# Overridden in docker-compose for the api service; set here for local dev
DATABASE_URL=postgresql+psycopg://tamarac:tamarac@localhost:5432/tamarac

# ── Demo mode (optional) ──────────────────────────────────────────────────────
# Set to true to bypass Auth0 and use the built-in mock Salesforce server.
# See .env.demo for a pre-filled version. Do NOT use in production.
# DEMO_MODE=false

# ── Auth0 (API) ───────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://tamarac-fsc-connector/api

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=<fernet-base64-key>

# ── SSE token signing ─────────────────────────────────────────────────────────
# Any long random string; used to sign short-lived SSE access tokens
SSE_TOKEN_SIGNING_KEY=<random-secret>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=<auth0-spa-client-id>
VITE_AUTH0_AUDIENCE=https://tamarac-fsc-connector/api
